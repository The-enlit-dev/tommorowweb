---
import { getCatalog, mediaUrl, money, type Product } from '../../lib/commerce'
export async function getStaticPaths() {
  const c = await getCatalog()
  return (c?.products ?? []).filter((p) => p.slug).map((product) => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props as { product: Product }
---
<main class="product">
  {product.image && <img src={mediaUrl(product.image)} alt={product.name} width="900" height="1125" />}
  <h1>{product.name}</h1>
  {product.description && <p>{product.description}</p>}
  <form id="add" data-name={product.name}>
    <fieldset>
      <legend>Choose</legend>
      {product.variants.map((v, i) => (
        <label>
          <input type="radio" name="variant" value={v.id} data-price={v.price} data-label={v.name} disabled={!v.in_stock} checked={i === product.variants.findIndex((x) => x.in_stock)} />
          {v.name} — {money(v.price)} {!v.in_stock ? '(sold out)' : v.low ? '(only a few left)' : ''}
        </label>
      ))}
    </fieldset>
    <button type="submit" disabled={!product.variants.some((v) => v.in_stock)}>Add to bag</button>
    <p id="added" hidden>Added. <a href="/cart/">View bag</a></p>
  </form>
</main>
<script>
  import { cart } from '../../lib/commerce'
  const form = document.getElementById('add') as HTMLFormElement
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const v = form.querySelector<HTMLInputElement>('input[name=variant]:checked')
    if (!v) return
    cart.add({ variant_id: v.value, name: `${form.dataset.name} — ${v.dataset.label}`, price: Number(v.dataset.price) })
    document.getElementById('added')!.hidden = false
  })
</script>
