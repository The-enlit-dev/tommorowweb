---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Orb from '../components/Orb.astro'
import { booking, whatsappLink } from '../config/site'

const waChat = whatsappLink('Hi Tomorrow Web — I’d like to book a 20-minute call.')
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const daysText = booking.days.map((d) => dayNames[d]).join(' and ')
const calLink = booking.externalUrl.replace(/^https?:\/\/(app\.)?cal\.com\//, '')
const calNamespace = calLink.split('/').pop() ?? 'booking'
const cover = [
  'What your business does and who it’s for',
  'What the website needs to do for you',
  'Your budget and timing',
  'Questions about how we work',
]
---

<Base
  title="Book a 20-minute call"
  description={`Book a ${booking.minutes}-minute call with Tomorrow Web. Pick a free slot in the calendar and get an instant confirmation.`}
>
  <section class="book" aria-labelledby="book-title">
    <div class="wrap book-grid">
      <div class="book-side">
        <div class="book-sticky">
          <p class="eyebrow mono" data-scramble>Book a call</p>
          <h1 id="book-title" class="book-title" data-lines="load">
            <span class="line"><span>Let’s talk for </span></span>
            <span class="line" style="--l:1"><span class="chrome">{booking.minutes} minutes. </span></span>
          </h1>
          <p class="lead book-intro">
            Pick a free slot in the calendar — you’ll get an instant confirmation by email,
            with the meeting details.
          </p>
          <button
            type="button"
            class="btn btn-sun book-now-inline"
            data-cal-link={calLink}
            data-cal-namespace={calNamespace}
            data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          >
            Book now <Icon name="arrow-right" size={18} />
          </button>

          <div class="book-card">
            <Orb class="book-orb" rings={false} />
            <dl class="book-facts">
              <div><dt class="mono">Length</dt><dd>{booking.minutes} minutes</dd></div>
              <div><dt class="mono">Usually</dt><dd>{daysText}</dd></div>
              <div><dt class="mono">How</dt><dd>{booking.methods.join(', ')}</dd></div>
            </dl>
            <h2 class="mono book-cover-h">What we’ll cover</h2>
            <ul class="book-cover">
              {cover.map((c) => <li><Icon name="check" size={16} /> {c}</li>)}
            </ul>
          </div>

        </div>
      </div>

      <div class="book-panel" data-reveal style="--d:.15s">
        <div class="book-now dark">
          <Orb class="book-now-orb" rings={false} />
          <p class="eyebrow mono">Free · {booking.minutes} minutes</p>
          <h2 class="book-now-h">See open slots and book instantly.</h2>
          <p class="book-now-p">The calendar shows times that are actually free. Choose one, add your details, and you’re booked — no back-and-forth.</p>
          <button
            type="button"
            class="btn btn-sun book-now-btn"
            data-cal-link={calLink}
            data-cal-namespace={calNamespace}
            data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          >
            Book now <Icon name="arrow-right" size={18} />
          </button>
          <p class="book-now-alt">
            Calendar not opening?{' '}
            <a href={booking.externalUrl} target="_blank" rel="noopener noreferrer">Book on Cal.com<span class="sr-only"> (opens in a new tab)</span></a>
          </p>
        </div>

        {
          waChat && (
            <p class="book-alt">
              Prefer to message?{' '}
              <a href={waChat} target="_blank" rel="noopener noreferrer">
                Chat on WhatsApp<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>

<!-- Cal.com element-click embed: clicking "Book now" opens the booking calendar in a popup. -->
<script is:inline define:vars={{ calNamespace }}>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  if (!window.__twCalInit) {
    window.__twCalInit = true;
    Cal("init", calNamespace, { origin: "https://app.cal.com" });
    Cal.config = Cal.config || {};
    Cal.config.forwardQueryParams = true;
    Cal.ns[calNamespace]("ui", { hideEventTypeDetails: false, layout: "month_view" });
  }
</script>

<style>
  .book {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 6rem));
    padding-bottom: var(--section);
  }
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 3rem clamp(2rem, 6vw, 7rem);
  }
  .book-sticky {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .book-title {
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    font-weight: 800;
    line-height: 1.02;
  }
  .book-intro {
    margin: 1.75rem 0 2rem;
    max-width: 42ch;
  }
  .book-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, #111, #070707 70%);
  }
  .book-card :global(.book-orb) {
    position: absolute;
    right: -3.5rem;
    top: -3.5rem;
    width: 10rem;
    opacity: 0.8;
  }
  .book-facts {
    position: relative;
    display: grid;
    gap: 0.9rem;
    margin: 0 0 1.75rem;
  }
  .book-facts dt {
    color: var(--ink-3);
    margin-bottom: 0.15rem;
  }
  .book-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .book-cover-h {
    margin-bottom: 0.9rem;
    color: var(--ink-3);
    font-weight: 500;
  }
  .book-cover {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .book-cover li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .book-cover :global(.icon) {
    flex: none;
    margin-top: 0.25rem;
  }
  .book-panel {
    align-self: start;
  }
  .book-now {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 90% at 100% 0%, #1a1a1a 0%, #070707 60%);
  }
  .book-now :global(.book-now-orb) {
    position: absolute;
    right: -4rem;
    bottom: -4rem;
    width: 14rem;
    opacity: 0.55;
    pointer-events: none;
  }
  .book-now-h {
    position: relative;
    margin: 0.75rem 0 1rem;
    max-width: 16ch;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 800;
    line-height: 1;
  }
  .book-now-p {
    position: relative;
    max-width: 40ch;
    margin-bottom: 2rem;
    color: var(--ink-2);
  }
  .book-now-btn {
    position: relative;
    min-height: 3.25rem;
    padding-inline: 1.75rem;
    font-size: 1.05rem;
  }
  .book-now-alt {
    position: relative;
    margin: 1.25rem 0 0;
    color: var(--ink-3);
    font-size: 0.95rem;
  }
  .book-now-inline {
    display: none;
    margin: -0.5rem 0 2rem;
  }
  .book-alt {
    margin: 1.5rem 0 0;
    color: var(--ink-2);
  }
  @media (max-width: 960px) {
    .book-grid {
      grid-template-columns: 1fr;
    }
    .book-now-inline {
      display: inline-flex;
    }
    .book-sticky {
      position: static;
    }
  }
</style>
