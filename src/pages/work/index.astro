---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import CtaBand from '../../components/CtaBand.astro'
import Icon from '../../components/Icon.astro'

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order)
const categories = ['All', ...new Set(work.flatMap((p) => p.data.categories))]
---

<Base
  title="Work"
  description="Selected websites by Tomorrow Web — a karate academy redesign, a product landing page and a personal portfolio. Real projects, with case studies."
>
  <PageHero
    label={`Work · ${String(work.length).padStart(2, '0')} projects`}
    lines={['Real work.', 'Honestly told.']}
    accent={1}
    intro="A small portfolio, and every project in it is real. We’re a young studio — so instead of invented logos and inflated numbers, you get the actual sites, what we built and why."
  />

  <section class="section-tight work-list" aria-label="Projects">
    <div class="wrap">
      <div class="filters" data-filter>
        <p class="mono filters-label" id="filter-label">Filter</p>
        <div class="filters-btns" role="group" aria-labelledby="filter-label">
          {categories.map((c) => <button type="button" class="chip" data-value={c} aria-pressed={c === 'All' ? 'true' : 'false'}>{c}</button>)}
        </div>
        <p class="sr-only" role="status" data-filter-status></p>
      </div>

      <div class="grid">
        {
          work.map((p, i) => (
            <div class="grid-item" data-reveal style={`--d:${(i % 2) * 0.1}s`} data-filter-item={p.data.categories.join('|')}>
              <ProjectCard project={p} index={i} eager={i < 2} level={2} />
            </div>
          ))
        }
        <div class="grid-item next" data-reveal>
          <a href="/contact/" class="next-card">
            <span class="next-sun" aria-hidden="true"></span>
            <span class="mono next-label">Next project</span>
            <span class="next-title" role="heading" aria-level="2">Yours?</span>
            <span class="next-text">We’re taking on new projects. Tell us about yours and we’ll reply personally.</span>
            <span class="link-arrow">Start a project <Icon name="arrow-right" size={18} /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Your website could be next." />
</Base>

<style>
  .work-list {
    padding-top: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  /* The filter needs JavaScript; html.js is set before first paint, so there's no layout shift. */
  :global(html:not(.js)) .filters {
    display: none;
  }
  .filters-label {
    margin: 0;
    color: var(--ink-3);
  }
  .filters-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters .chip {
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .filters .chip:hover {
    border-color: var(--ink);
  }
  .filters .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 4vw, 3.5rem);
  }
  .grid-item[hidden] {
    display: none;
  }
  .grid-item:nth-child(even) {
    margin-top: clamp(0rem, 8vw, 7rem);
  }
  .next-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    height: 100%;
    min-height: 26rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--line-strong);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.3s, background 0.4s;
  }
  .next-card:hover {
    border-color: var(--ink);
    background: var(--paper-2);
  }
  .next-sun {
    position: absolute;
    top: -5rem;
    right: -5rem;
    width: 16rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    transition: transform 0.9s var(--ease-out);
  }
  .next-card:hover .next-sun {
    transform: translate(-1.5rem, 1.5rem);
  }
  .next-label {
    color: var(--ink-3);
  }
  .next-title {
    font-family: var(--f-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: -0.034em;
    line-height: 0.9;
  }
  .next-text {
    max-width: 34ch;
    color: var(--ink-2);
  }
  .next-card .link-arrow {
    align-self: flex-start;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid-item:nth-child(even) {
      margin-top: 0;
    }
    .next-card {
      min-height: 20rem;
    }
  }
</style>
