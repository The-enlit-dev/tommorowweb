---
import { getCollection } from 'astro:content'
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import SectionHead from '../components/SectionHead.astro'
import Standards from '../components/Standards.astro'
import Faq from '../components/Faq.astro'
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'
import { services, faqs } from '../config/site'

const work = await getCollection('work', ({ data }) => !data.draft)
const byId = new Map(work.map((w) => [w.id, w]))

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  ...services.map((s) => ({
    '@type': 'Service',
    name: s.title,
    description: s.lead,
    serviceType: s.title,
    provider: { '@type': 'Organization', name: 'Tomorrow Web' },
  })),
]
---

<Base
  title="Services"
  description="Business websites, restaurant and café websites, portfolios, landing pages, redesigns and website maintenance — designed and built by Tomorrow Web."
  jsonLd={jsonLd}
>
  <PageHero
    label="Services"
    lines={['Six ways to a', 'better website.']}
    accent={0}
    intro="Whether you need your first website, a single page for a launch, or a fresh start for a site that’s fallen behind — here’s what we do, who it’s for and what’s included."
  >
    <nav class="svc-index" aria-label="Services on this page" data-reveal style="--d:.3s">
      <ol>
        {
          services.map((s, i) => (
            <li>
              <a href={`#${s.slug}`}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span> {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>

  <div class="svc-list">
    {
      services.map((s, i) => {
        const example = s.example ? byId.get(s.example) : undefined
        return (
          <section class="svc" id={s.slug} aria-labelledby={`${s.slug}-title`}>
            <div class="wrap svc-grid">
              <div class="svc-side">
                <div class="svc-sticky">
                  <p class="svc-num mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}
                  </p>
                  <h2 id={`${s.slug}-title`} class="svc-title" data-reveal>
                    {s.title}
                  </h2>
                  <p class="svc-short" data-reveal style="--d:.08s">
                    {s.short}
                  </p>
                  <a href={`/contact/?type=${s.slug}`} class="btn btn-ink btn-sm" data-reveal style="--d:.14s">
                    Enquire about this <Icon name="arrow-right" size={16} />
                    <span class="sr-only"> — {s.title}</span>
                  </a>
                </div>
              </div>

              <div class="svc-main">
                <p class="svc-lead" data-reveal>
                  {s.lead}
                </p>

                <div class="svc-cols">
                  <div data-reveal>
                    <h3 class="mono svc-h">Ideal for</h3>
                    <ul class="svc-ideal">
                      {s.idealFor.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                  <div data-reveal style="--d:.08s">
                    <h3 class="mono svc-h">What’s included</h3>
                    <ul class="svc-includes">
                      {s.includes.map((x) => (
                        <li>
                          <Icon name="check" size={18} />
                          {x}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                {s.note && (
                  <p class="svc-note" data-reveal>
                    {s.note}
                  </p>
                )}

                {example && (
                  <a href={`/work/${example.id}/`} class="svc-example" data-reveal>
                    <span class="svc-example-img">
                      <Picture src={example.data.cover} alt="" widths={[320, 640]} sizes="12rem" formats={['avif']}
          fallbackFormat="webp" />
                    </span>
                    <span class="svc-example-text">
                      <span class="mono">See it in practice</span>
                      <span class="svc-example-title">{example.data.title}</span>
                      <span class="svc-example-link">
                        Read the case study <Icon name="arrow-right" size={16} />
                      </span>
                    </span>
                  </a>
                )}
              </div>
            </div>
          </section>
        )
      })
    }
  </div>

  <Standards />

  <section class="section faq-sec" aria-labelledby="faq-title">
    <div class="wrap">
      <SectionHead label="Questions" id="faq-title" intro="The things people usually ask before getting started. Something else on your mind? Just ask in your enquiry.">
        <span class="line"><span>Good questions, </span></span>
        <span class="line" style="--l:1"><span>straight answers. </span></span>
      </SectionHead>
      <div class="faq-wrap">
        <Faq />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .svc-index ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    max-width: 34rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .svc-index a .mono {
    font-size: 0.68rem;
    color: var(--ink-3);
  }
  .svc-index a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-accent);
  }
  .svc-index a:hover .mono {
    color: #333;
  }
  @media (max-width: 760px) {
    .svc-index ol {
      justify-content: flex-start;
    }
  }

  .svc {
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(3.5rem, 8vw, 7rem);
    scroll-margin-top: var(--header-h);
  }
  .svc:nth-child(even) {
    background: var(--paper-2);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 2.5rem clamp(2rem, 6vw, 7rem);
  }
  .svc-sticky {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .svc-num {
    margin: 0 0 1.5rem;
    color: var(--sun-deep);
  }
  .svc-title {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 0.95;
  }
  .svc-short {
    margin: 1.25rem 0 1.75rem;
    color: var(--ink-2);
    font-size: 1.15rem;
  }
  .svc-lead {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-size: clamp(1.35rem, 2.2vw, 1.95rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .svc-cols {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .svc-h {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }
  .svc-ideal,
  .svc-includes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .svc-ideal li {
    padding-left: 1.1rem;
    position: relative;
  }
  .svc-ideal li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--sun);
  }
  .svc-includes li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .svc-includes :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--sun-deep);
  }
  .svc-note {
    margin: 2rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--sun);
    background: rgb(255 255 255 / 0.04);
    color: var(--ink-2);
  }
  .svc:nth-child(even) .svc-note {
    background: var(--paper-3);
  }
  .svc-example {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s;
  }
  .svc-example:hover {
    border-color: var(--ink);
  }
  .svc-example-img {
    flex: none;
    width: 9rem;
    border-radius: 8px;
    overflow: hidden;
  }
  .svc-example-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .svc-example-text .mono {
    color: var(--ink-3);
  }
  .svc-example-title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .svc-example-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .faq-wrap {
    max-width: 62rem;
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .svc-grid,
    .svc-cols {
      grid-template-columns: 1fr;
    }
    .svc-sticky {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .svc-example-img {
      width: 6rem;
    }
  }
</style>
