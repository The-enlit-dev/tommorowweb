---
import { business, whatsappLink, whatsappDisplay } from '../config/site'
import Icon from './Icon.astro'
import Orb from './Orb.astro'

interface Props {
  title?: string
  text?: string
}
const {
  title = 'Let’s build your tomorrow.',
  text = 'Tell us what you have in mind, or book a 20-minute call. We’ll reply personally with honest advice, ideas and a clear next step — no obligation.',
} = Astro.props
const wa = whatsappLink()
const words = title.split(' ')
const last = words.pop()
const marquee = ['Business websites', 'Restaurants & cafés', 'Portfolios', 'Landing pages', 'Redesigns', 'Care']
---

<section class="cta dark" aria-labelledby="cta-title">
  <div class="cta-orb-wrap" data-sunrise aria-hidden="true">
    <Orb class="cta-orb" />
  </div>
  <div class="wrap cta-inner">
    <p class="eyebrow mono" data-reveal data-scramble>Start a project</p>
    <h2 id="cta-title" class="cta-title" data-lines>
      <span class="line"><span>{words.join(' ')} </span></span>
      <span class="line" style="--l:1"><span class="chrome">{last}</span></span>
    </h2>
    <div class="cta-foot">
      <p class="lead" data-reveal>{text}</p>
      <div class="cta-actions" data-reveal style="--d:.1s">
        <a href="/contact/" class="btn btn-sun" data-magnetic>Start a project <Icon name="arrow-right" size={18} /></a>
        <a href="/book/" class="btn btn-ghost-light" data-magnetic>Book a 20-min call</a>
        {
          wa ? (
            <a href={wa} class="btn btn-ghost-light" target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={18} /> WhatsApp<span class="sr-only"> ({whatsappDisplay()}, opens in a new tab)</span>
            </a>
          ) : (
            business.email && (
              <a href={`mailto:${business.email}`} class="btn btn-ghost-light">
                <Icon name="mail" size={18} /> Email us
              </a>
            )
          )
        }
      </div>
    </div>
  </div>

  <div class="cta-marquee" aria-hidden="true">
    <div class="cta-track">
      {
        [0, 1].map(() => (
          <span class="cta-set">
            {marquee.map((m) => (
              <span>
                {m}
                <i />
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cta {
    overflow: hidden;
    padding-block: clamp(6rem, 14vw, 12rem) 0;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
  }
  .cta-title {
    font-size: clamp(2.3rem, 5.4vw, 5.2rem);
    font-weight: 800;
    line-height: 1.04;
  }
  .cta-foot {
    display: grid;
    gap: 2rem;
    justify-items: start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .cta-foot .lead {
    max-width: 46ch;
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* The orb sits to the right and rises as the section scrolls up. */
  .cta-orb-wrap {
    --rise: 0.5;
    position: absolute;
    right: -8vw;
    top: 0;
    width: min(46vw, 680px);
    pointer-events: none;
    transform: translateY(calc(40% - var(--rise) * 45%));
    will-change: transform;
  }
  .cta-orb {
    width: 100%;
  }

  .cta-marquee {
    position: relative;
    z-index: 1;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .cta-track {
    display: flex;
    width: max-content;
  }
  .cta-set {
    display: flex;
    flex: none;
  }
  .cta-set span {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--f-display);
    font-variation-settings: 'ROND' 100;
    font-weight: 800;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .cta-set i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 14px rgb(255 255 255 / 0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-track {
      animation: cta-marquee 40s linear infinite;
    }
  }
  @keyframes cta-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 760px) {
    .cta {
      padding-top: calc(clamp(6rem, 14vw, 12rem) + 30vw);
    }
    .cta-orb-wrap {
      right: -14vw;
      width: 64vw;
      transform: translateY(calc(10% - var(--rise) * 25%));
    }
  }
</style>
