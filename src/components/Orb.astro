---
/**
 * The chrome orb: a monochrome sphere with a slowly turning highlight, tilted
 * orbit rings and an orbiting point of light. Purely decorative.
 * Size it with width on the class you pass in; it keeps a square ratio.
 */
interface Props {
  class?: string
  rings?: boolean
}
const { class: className, rings = true } = Astro.props
---

<div class:list={['orb', className]} aria-hidden="true">
  {
    rings && (
      <>
        <span class="orb-orbit orb-orbit-1">
          <i />
        </span>
        <span class="orb-orbit orb-orbit-2">
          <i />
        </span>
      </>
    )
  }
  <span class="orb-core"></span>
</div>

<style>
  .orb {
    position: relative;
    aspect-ratio: 1;
    perspective: 1200px;
  }
  .orb-core {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--orb);
    box-shadow:
      inset -2.5em -3em 6em rgb(0 0 0 / 0.85),
      inset 0.4em 0.4em 1.2em rgb(255 255 255 / 0.25),
      0 0 7em rgb(255 255 255 / 0.1);
    overflow: hidden;
    font-size: clamp(6px, 1.1vw, 14px);
  }
  /* A soft chrome highlight that drifts around the sphere. */
  .orb-core::after {
    content: '';
    position: absolute;
    inset: -20%;
    background: conic-gradient(from 0deg, transparent 0deg, rgb(255 255 255 / 0.28) 40deg, transparent 90deg, transparent 200deg, rgb(255 255 255 / 0.12) 240deg, transparent 290deg);
    mix-blend-mode: screen;
    filter: blur(14px);
  }
  /* Tilted orbit rings; each ring turns, carrying its point of light round. */
  .orb-orbit {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.16);
    transform: rotateX(72deg) rotateZ(var(--z, 0deg));
    transform-style: preserve-3d;
  }
  .orb-orbit-2 {
    inset: -30%;
    border-color: rgb(255 255 255 / 0.08);
    --z: 24deg;
  }
  .orb-orbit i {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px 2px rgb(255 255 255 / 0.8);
  }

  @media (prefers-reduced-motion: no-preference) {
    .orb-core::after {
      animation: orb-spin 14s linear infinite;
    }
    .orb-orbit {
      animation: orb-tilt 18s linear infinite;
    }
    .orb-orbit-2 {
      animation-duration: 30s;
      animation-direction: reverse;
    }
  }
  @keyframes orb-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orb-tilt {
    to {
      transform: rotateX(72deg) rotateZ(calc(var(--z, 0deg) + 360deg));
    }
  }
</style>
