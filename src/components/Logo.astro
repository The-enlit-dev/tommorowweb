---
/**
 * The Tomorrow Web wordmark, as vector paths traced from the logo artwork.
 * `variant="hor"` is the one-line version (header), `"stack"` the two-line logo.
 */
import { logoPaths } from './logo-paths'

interface Props {
  variant?: 'hor' | 'stack'
  class?: string
  /** Accessible name. Pass '' when the logo is purely decorative. */
  label?: string
}
const { variant = 'hor', class: className, label = 'Tomorrow Web' } = Astro.props
const p = logoPaths[variant]
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const }
---

<svg
  class:list={['logo', `logo-${variant}`, className]}
  viewBox={`0 0 ${p.w} ${p.h}`}
  width={p.w}
  height={p.h}
  fill="currentColor"
  focusable="false"
  {...a11y}
>
  <path d={p.d} fill-rule={p.rule}></path>
</svg>

<style>
  .logo {
    display: block;
    width: auto;
    max-width: 100%;
  }
  .logo-hor {
    height: 1.15rem;
  }
  .logo-stack {
    height: auto;
    width: 100%;
  }
</style>
