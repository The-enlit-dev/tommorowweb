---
/**
 * The Tomorrow Web mark: a sun rising over the horizon line.
 */
interface Props {
  class?: string
  showText?: boolean
}
const { class: className, showText = true } = Astro.props
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <path class="logo-sun" d="M6 21a10 10 0 0 1 20 0Z" fill="var(--sun)" />
    <rect x="2" y="21" width="28" height="2.5" rx="1.25" fill="currentColor" />
  </svg>
  {showText && <span class="logo-text">Tomorrow <span>Web</span></span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-mark {
    flex: none;
    width: 1.9em;
    height: 1.9em;
    overflow: visible;
  }
  .logo-sun {
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease-out);
  }
  :global(a:hover) > .logo .logo-sun,
  :global(a:focus-visible) > .logo .logo-sun {
    transform: translateY(-2px);
  }
  .logo-text span {
    font-weight: 400;
  }
</style>
