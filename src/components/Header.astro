---
import { business, nav, whatsappLink, whatsappDisplay } from '../config/site'
import Logo from './Logo.astro'
import Icon from './Icon.astro'

const path = Astro.url.pathname
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href))
const wa = whatsappLink()
---

<header class="site-header" data-header transition:name="site-header">
  <div class="wrap header-inner">
    <a href="/" class="header-logo">
      <Logo /><span class="sr-only"> — home</span>
    </a>

    <nav class="header-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-ctas">
      <a href="/book/" class="btn btn-ghost btn-sm header-book" aria-current={isActive('/book/') ? 'page' : undefined}>
        Book a call
      </a>
      <a href="/contact/" class="btn btn-ink btn-sm" aria-current={isActive('/contact/') ? 'page' : undefined}>
        Start a project <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="menu-toggle-label">Menu</span>
      <span class="menu-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <nav class="wrap mobile-menu-inner" aria-label="Mobile">
    <ol class="mobile-menu-links">
      {
        [{ label: 'Home', href: '/' }, ...nav, { label: 'Contact', href: '/contact/' }].map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={(item.href === '/' ? path === '/' : isActive(item.href)) ? 'page' : undefined}>
              <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
    <div class="mobile-menu-foot">
      <a href="/contact/" class="btn btn-sun">
        Start a project <Icon name="arrow-right" size={18} />
      </a>
      <a href="/book/" class="btn btn-ghost-light">Book a 20-min call</a>
      {
        wa && (
          <a href={wa} class="btn btn-ghost-light" target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} /> WhatsApp<span class="sr-only"> {whatsappDisplay()} (opens in a new tab)</span>
          </a>
        )
      }
      {business.email && <a href={`mailto:${business.email}`} class="mobile-menu-mail">{business.email}</a>}
      <a href="/portal/login/" class="mobile-menu-mail" data-astro-reload>Client login →</a>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .site-header.is-scrolled {
    background: rgb(5 5 5 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  :global(html.menu-open) .site-header {
    transform: none;
    background: var(--night);
    color: var(--on-night);
    box-shadow: none;
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .header-logo {
    margin-right: auto;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s;
  }
  .header-logo:hover {
    opacity: 0.75;
  }
  .header-ctas {
    display: flex;
    gap: 0.5rem;
  }
  .header-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header-nav a {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    border-radius: 99px;
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 8px rgb(255 255 255 / 0.8);
    transform: scale(0);
    transition: transform 0.4s var(--ease-out);
  }
  .header-nav a:hover::after,
  .header-nav a[aria-current='page']::after {
    transform: scale(1);
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    height: 44px;
    padding: 0 0.25rem 0 1rem;
    border: 0;
    background: none;
    color: inherit;
    font: 500 0.95rem/1 var(--f-body);
    cursor: pointer;
  }
  .menu-toggle-lines {
    position: relative;
    width: 26px;
    height: 12px;
  }
  .menu-toggle-lines i {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.45s var(--ease-out);
  }
  .menu-toggle-lines i:first-child {
    top: 0;
  }
  .menu-toggle-lines i:last-child {
    bottom: 0;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-lines i:first-child {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-lines i:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--night) var(--dots);
    background-size: var(--dot-gap) var(--dot-gap);
    color: var(--on-night);
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }
  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }
  .mobile-menu-inner {
    min-height: calc(100% - 1px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: 1.5rem 2rem;
  }
  .mobile-menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu-links li {
    border-bottom: 1px solid var(--line-night);
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.5s ease,
      transform 0.7s var(--ease-out);
    transition-delay: calc(0.12s + var(--i) * 0.05s);
  }
  .mobile-menu.is-open .mobile-menu-links li {
    opacity: 1;
    transform: none;
  }
  .mobile-menu-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0;
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 10vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: inherit;
    text-decoration: none;
  }
  .mobile-menu-links a .mono {
    font-size: 0.75rem;
    color: var(--on-night-2);
    letter-spacing: 0.05em;
    min-width: 1.75rem;
  }
  .mobile-menu-links a {
    color: var(--ink-2);
    transition: color 0.3s;
  }
  .mobile-menu-links a:hover,
  .mobile-menu-links a[aria-current='page'] {
    color: var(--sun);
    text-shadow: 0 0 24px rgb(255 255 255 / 0.45);
  }
  .mobile-menu-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .mobile-menu-mail {
    width: 100%;
    margin-top: 0.5rem;
    color: var(--on-night-2);
    font-size: 0.95rem;
  }

  @media (max-width: 1080px) {
    .header-book {
      display: none;
    }
    .header-inner {
      gap: 1.25rem;
    }
  }
  @media (max-width: 860px) {
    .header-nav,
    .header-ctas {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (min-width: 861px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>
