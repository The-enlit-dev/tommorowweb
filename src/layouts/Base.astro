---
import { ClientRouter } from 'astro:transitions'
import '../styles/fonts.css'
import displayFont from '@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url'
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '../styles/global.css'
import '../styles/forms.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { business } from '../config/site'

interface Props {
  /** Page title. The studio name is appended automatically unless `fullTitle` is set. */
  title: string
  description: string
  /** Absolute or root-relative path to a 1200×630 image. Defaults to /og.png. */
  image?: string
  imageAlt?: string
  fullTitle?: boolean
  noindex?: boolean
  type?: 'website' | 'article'
  /** One or more schema.org objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description,
  image = '/og.png',
  imageAlt = `${business.name} — ${business.tagline}`,
  fullTitle = false,
  noindex = false,
  type = 'website',
  jsonLd,
} = Astro.props

const pageTitle = fullTitle ? title : `${title} — ${business.name}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}

    <ClientRouter fallback="swap" />
    <script is:inline>
      // Hide scroll-reveal content only once JS runs, so nothing is lost without it.
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true" transition:persist></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main'
    </script>
  </body>
</html>
