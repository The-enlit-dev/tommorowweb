---
// Layout for the private portal (/portal/**). Never indexed, no public header/footer,
// no smooth scrolling or page transitions: just a fast, app-like shell.
import '../styles/fonts.css'
import '../styles/global.css'
import '../styles/forms.css'
import '../styles/portal.css'
import displayFont from '@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url'
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

interface Props {
  title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="en-IN" class="portal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Tomorrow Web portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <!-- Netlify Forms: lets the portal email Tomorrow Web (e.g. new change requests). Never shown. -->
    <form name="portal-alert" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input name="kind" /><input name="business" /><input name="title" /><input name="link" /><input name="by" />
      <input name="bot-field" />
    </form>
    <noscript><p class="p-noscript">The portal needs JavaScript. Please enable it to sign in.</p></noscript>
  </body>
</html>
